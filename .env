NEXTAUTH_SECRET=dev-only-secret-change-before-any-real-deploy
NEXTAUTH_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Aaravya Hospital <no-reply@aaravyahospital.local>"
