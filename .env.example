# Copy this file to .env and fill in real values before running anything
# outside Docker Compose (e.g. `npx prisma studio`, `npm run dev` on the
# host). Docker Compose itself does NOT read this file — its own
# `environment:` block in docker-compose.yml supplies dev-only defaults to
# the app container directly.
#
# Before any real deployment: generate a strong NEXTAUTH_SECRET (e.g.
# `openssl rand -base64 32`), point DATABASE_URL/SMTP_* at real production
# services, and rotate the seeded admin password (see prisma/seed.ts) —
# none of the local dev defaults are safe to reuse in production.

DATABASE_URL="postgresql://user:password@localhost:5434/aaravya"
NEXTAUTH_SECRET="replace-with-a-strong-random-value"
NEXTAUTH_URL="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Aaravya Hospital <no-reply@aaravyahospital.local>"
